generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  supervisor
  operator
  viewer
}

enum UserStatus {
  active
  inactive
  pending
}

enum ProductStatus {
  active
  inactive
  discontinued
}

enum PositionStatus {
  free
  occupied
  blocked
  reserved
}

enum MovementType {
  entry
  exit
  transfer
  loss
  adjustment
  inventory
}

enum ExitReason {
  sale
  transfer
  loss
  break
  internal
}

enum LotStatus {
  valid
  expiring
  expired
  quarantine
}

enum InventoryCountType {
  full
  partial
  cyclic
}

enum InventoryCountStatus {
  planned
  in_progress
  review
  completed
}

enum SupplierStatus {
  active
  inactive
}

enum CustomerStatus {
  active
  inactive
}

model User {
  id         String     @id @default(cuid())
  name       String
  email      String     @unique
  password   String
  role       UserRole   @default(operator)
  department String
  status     UserStatus @default(pending)
  avatarUrl  String?
  lastLogin  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements             Movement[]
  auditLogs             AuditLog[]
  inventoryCounts       InventoryCount[]
  notifications         Notification[]
  countedInventoryItems InventoryCountItem[] @relation("InventoryItemCounter")

  @@map("users")
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  color     String   @default("#6366f1")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("categories")
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("brands")
}

model Supplier {
  id          String         @id @default(cuid())
  name        String
  tradeName   String
  cnpj        String         @unique
  email       String
  phone       String
  contactName String
  category    String
  status      SupplierStatus @default(active)
  city        String
  state       String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  products  Product[]
  movements Movement[]
  lots      Lot[]

  @@map("suppliers")
}

model Product {
  id            String        @id @default(cuid())
  name          String
  internalCode  String        @unique
  sku           String        @unique
  barcode       String        @unique
  unit          String
  weight        Float         @default(0)
  width         Float         @default(0)
  height        Float         @default(0)
  depth         Float         @default(0)
  description   String?
  purchasePrice Decimal       @default(0) @db.Decimal(12, 2)
  salePrice     Decimal       @default(0) @db.Decimal(12, 2)
  minStock      Int           @default(0)
  maxStock      Int           @default(0)
  currentStock  Int           @default(0)
  status        ProductStatus @default(active)
  imageUrl      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id])

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  movements           Movement[]
  warehouseAddresses  WarehouseAddress[]
  lots                Lot[]
  inventoryCountItems InventoryCountItem[]

  @@index([status, currentStock, minStock])
  @@index([createdAt])
  @@map("products")
}

model WarehouseAddress {
  id        String         @id @default(cuid())
  code      String         @unique
  aisle     String
  street    String
  shelf     String
  level     String
  position  String
  status    PositionStatus @default(free)
  capacity  Float
  occupied  Float          @default(0)
  lotNumber String?
  quantity  Int?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  fromMovements Movement[] @relation("FromAddress")
  toMovements   Movement[] @relation("ToAddress")
  lots          Lot[]      @relation("LotAddress")

  @@index([aisle, street, shelf])
  @@index([status, code])
  @@map("warehouse_addresses")
}

model Movement {
  id             String       @id @default(cuid())
  type           MovementType
  quantity       Int
  unitCost       Decimal      @default(0) @db.Decimal(12, 2)
  totalValue     Decimal      @default(0) @db.Decimal(14, 2)
  invoiceNumber  String?
  lotNumber      String?
  expirationDate DateTime?
  exitReason     ExitReason?
  notes          String?
  createdAt      DateTime     @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName String?

  lotId String?
  lot   Lot?    @relation("MovementLot", fields: [lotId], references: [id], onDelete: SetNull)

  fromAddressId String?
  fromAddress   WarehouseAddress? @relation("FromAddress", fields: [fromAddressId], references: [id])

  toAddressId String?
  toAddress   WarehouseAddress? @relation("ToAddress", fields: [toAddressId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([createdAt, type])
  @@index([productId, createdAt])
  @@index([supplierId, createdAt])
  @@index([customerId])
  @@index([lotId])
  @@map("movements")
}

model Lot {
  id                String    @id @default(cuid())
  lotNumber         String    @unique
  quantity          Int
  manufacturingDate DateTime
  expirationDate    DateTime
  address           String
  addressId         String?
  status            LotStatus @default(valid)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id])

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  warehouseAddress WarehouseAddress? @relation("LotAddress", fields: [addressId], references: [id], onDelete: Restrict)
  movements        Movement[]        @relation("MovementLot")

  @@index([productId, status])
  @@index([expirationDate, status])
  @@index([addressId])
  @@map("lots")
}

model InventoryCount {
  id           String               @id @default(cuid())
  name         String
  type         InventoryCountType
  status       InventoryCountStatus @default(planned)
  startDate    DateTime
  endDate      DateTime?
  totalItems   Int                  @default(0)
  countedItems Int                  @default(0)
  divergences  Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  responsibleId String
  responsible   User   @relation(fields: [responsibleId], references: [id])

  items InventoryCountItem[]

  @@index([status, createdAt])
  @@map("inventory_counts")
}

model InventoryCountItem {
  id               String    @id @default(cuid())
  expectedQuantity Int
  countedQuantity  Int?
  discrepancy      Int       @default(0)
  countedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  inventoryCountId String
  inventoryCount   InventoryCount @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  productId        String
  product          Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  countedById      String?
  countedBy        User?          @relation("InventoryItemCounter", fields: [countedById], references: [id], onDelete: SetNull)

  @@unique([inventoryCountId, productId])
  @@index([inventoryCountId, countedQuantity])
  @@map("inventory_count_items")
}

model Customer {
  id          String         @id @default(cuid())
  name        String
  tradeName   String
  cnpj        String         @unique
  email       String
  phone       String?
  contactName String?
  city        String
  state       String
  status      CustomerStatus @default(active)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  movements Movement[]

  @@map("customers")
}

model Notification {
  id       String   @id @default(cuid())
  alertKey String
  readAt   DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([alertKey, userId])
  @@index([userId])
  @@map("notifications")
}

model AuditLog {
  id         String @id @default(cuid())
  action     String
  entity     String
  entityId   String
  entityName String
  oldValue   Json?
  newValue   Json?
  ip         String

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([entity, createdAt])
  @@map("audit_logs")
}
