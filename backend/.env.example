DATABASE_URL="postgresql://user:password@localhost:5432/wms_db"
PORT=3001
JWT_SECRET="your-super-secret-jwt-key-here"
JWT_EXPIRES_IN="7d"
NODE_ENV="development"

# Serviço de previsão de demanda EXTERNO (opcional). O repositório não inclui esse serviço: sem ele, a previsão
# do analytics usa média móvel. Defina a URL de um serviço compatível (ver src/services/ml.service.ts) para ativá-lo.
# ML_SERVICE_URL=
# ML_TIMEOUT_MS=8000


# Fotos de produto (upload). STORAGE_DRIVER: "s3" (AWS S3 ou compatível) ou "local" (pasta em disco, só desenvolvimento).
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false        # true para MinIO e similares
# S3_ENDPOINT=                     # opcional: endpoint S3-compatível
# STORAGE_KEY_PREFIX=stockiq/      # prefixo das chaves dentro do bucket (útil quando o bucket é compartilhado)
# STORAGE_URL_TTL_SECONDS=3600     # validade das URLs assinadas devolvidas pela API
# STORAGE_MAX_IMAGE_MB=5           # tamanho máximo de cada foto
# STORAGE_ORPHAN_GRACE_DAYS=7      # carência antes de `npm run storage:cleanup` apagar objetos sem produto
# Driver local:
# STORAGE_LOCAL_DIR=storage-data
# STORAGE_SIGNING_SECRET=          # obrigatório no driver local (assina as URLs de /api/files)
# API_PUBLIC_URL=http://localhost:3001

# Mensageria: ajuste de estoque do inventário processado por fila (Amazon SQS). QUEUE_DRIVER: "sqs" ou "local" (em memória, só desenvolvimento).
# Criar a fila + DLQ: npm run queues:setup (imprime as linhas abaixo).
# QUEUE_DRIVER=sqs
# SQS_INVENTORY_QUEUE_URL=
# SQS_REGION=                      # padrão: S3_REGION
# SQS_ACCESS_KEY_ID=               # padrão: S3_ACCESS_KEY_ID
# SQS_SECRET_ACCESS_KEY=           # padrão: S3_SECRET_ACCESS_KEY
# SQS_SESSION_TOKEN=               # só para credenciais temporárias (ex.: AWS Academy)
# SQS_ENDPOINT=                    # opcional: servidor compatível (ElasticMQ/LocalStack)
# SQS_QUEUE_PREFIX=stockiq         # nome das filas criadas pelo setup: <prefixo>-inventory e <prefixo>-inventory-dlq
# QUEUE_VISIBILITY_TIMEOUT_SECONDS=120   # tempo que a mensagem fica invisível enquanto o worker processa
# QUEUE_MAX_RECEIVES=3             # tentativas antes de ir para a DLQ (igual ao maxReceiveCount da fila)
# QUEUE_WORKER=embedded            # embedded: a API também consome a fila; off: use `npm run worker` em outro processo
# INVENTORY_BATCH_SIZE=25          # itens processados por lote (o progresso é atualizado a cada lote)
